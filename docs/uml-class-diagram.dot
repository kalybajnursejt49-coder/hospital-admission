digraph G {
rankdir=TB; nodesep=0.35; ranksep=0.7; compound=true;
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
subgraph cluster_client { label="Client"; style=dashed;
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff7b0"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+main(args)</TD></TR></TABLE>>];
KitchenApp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff7b0"><B>KitchenApp</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+orders(): OrderFacade<BR/>+admin(): AdminFacade<BR/>+reset(dir)</TD></TR></TABLE>>];
}
subgraph cluster_facade { label="kitchen.facade (Facades)"; style=filled; color="#fbe9f4";
OrderFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>&lt;&lt;Facade&gt;&gt;<BR/>OrderFacade</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+placeOrder(dish, qty, quality, zone): int</TD></TR></TABLE>>];
AdminFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>&lt;&lt;Facade&gt;&gt;<BR/>AdminFacade</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+report(id)<BR/>+listChains()<BR/>+compensate(id)<BR/>+recoverPending()<BR/>+simulateCrashAfterB(...)</TD></TR></TABLE>>];
Compensator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>Compensator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~compensate(id): List</TD></TR></TABLE>>];
ChainRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>ChainRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+find(id)<BR/>+setStatus(id, status)</TD></TR></TABLE>>];
ChainRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>ChainRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-orderId<BR/>-status</TD></TR></TABLE>>];
ChainStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>&lt;&lt;enum&gt;&gt;<BR/>ChainStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDING_B<BR/>PENDING_C<BR/>COMPLETED<BR/>COMPENSATED</TD></TR></TABLE>>];
OrderFailedException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>OrderFailedException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-stage<BR/>-orderId</TD></TR></TABLE>>];
InvalidRequestException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f7d1e8"><B>InvalidRequestException</B></TD></TR></TABLE>>];
}
subgraph cluster_a { label="Subsystem A: kitchen.intake"; style=filled; color="#e8f3ff";
OrderQueue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>OrderQueue</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+accept(dish, qty): int<BR/>+complete(id)<BR/>+cancel(id)<BR/>+restock(ing, n)</TD></TR></TABLE>>];
InventoryChecker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>&lt;&lt;business logic&gt;&gt;<BR/>InventoryChecker</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+needed(dish, qty)<BR/>+firstMissing(stock, dish, qty)</TD></TR></TABLE>>];
IntakeRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>&lt;&lt;gateway&gt;&gt;<BR/>IntakeRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loadOrders()/saveOrders()<BR/>+loadStock()/saveStock()</TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>&lt;&lt;entity&gt;&gt;<BR/>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id, dish, quantity<BR/>-status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+changeStatus(next)</TD></TR></TABLE>>];
OrderStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>&lt;&lt;enum&gt;&gt;<BR/>OrderStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">QUEUED<BR/>COMPLETED<BR/>CANCELLED</TD></TR></TABLE>>];
IntakeException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#cfe8ff"><B>IntakeException</B></TD></TR></TABLE>>];
}
subgraph cluster_b { label="Subsystem B: kitchen.cooking"; style=filled; color="#fff1dc";
CookingLine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>CookingLine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+start(orderId, dish, quality)<BR/>+discard(orderId)<BR/>+find(orderId)</TD></TR></TABLE>>];
StationAllocator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>&lt;&lt;business logic&gt;&gt;<BR/>StationAllocator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+allocate(dish, tickets): String</TD></TR></TABLE>>];
QualityChecker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>&lt;&lt;business logic&gt;&gt;<BR/>QualityChecker</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+passes(score): boolean</TD></TR></TABLE>>];
CookingRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>&lt;&lt;gateway&gt;&gt;<BR/>CookingRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+load()<BR/>+save(tickets)</TD></TR></TABLE>>];
Ticket [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>&lt;&lt;entity&gt;&gt;<BR/>Ticket</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-orderId, dish, station<BR/>-status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+changeStatus(next)</TD></TR></TABLE>>];
TicketStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>&lt;&lt;enum&gt;&gt;<BR/>TicketStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ASSIGNED<BR/>COOKED<BR/>DISCARDED</TD></TR></TABLE>>];
CookingException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffe3b8"><B>CookingException</B></TD></TR></TABLE>>];
}
subgraph cluster_c { label="Subsystem C: kitchen.delivery"; style=filled; color="#e9fae9";
BillingModule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>BillingModule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+issue(orderId, dish, qty)<BR/>+pay(orderId)<BR/>+voidBill(orderId)</TD></TR></TABLE>>];
DeliveryDispatcher [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>DeliveryDispatcher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+dispatch(orderId, zone): String</TD></TR></TABLE>>];
PriceCalculator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>&lt;&lt;business logic&gt;&gt;<BR/>PriceCalculator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+total(dish, qty): int</TD></TR></TABLE>>];
DeliveryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>&lt;&lt;gateway&gt;&gt;<BR/>DeliveryRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+load()<BR/>+save(bills)<BR/>+find(orderId)</TD></TR></TABLE>>];
Bill [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>&lt;&lt;entity&gt;&gt;<BR/>Bill</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-orderId, amount, zone, courier<BR/>-status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+changeStatus(next)<BR/>+assign(zone, courier)</TD></TR></TABLE>>];
BillStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>&lt;&lt;enum&gt;&gt;<BR/>BillStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ISSUED<BR/>PAID<BR/>VOIDED</TD></TR></TABLE>>];
DeliveryException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#d6f5d6"><B>DeliveryException</B></TD></TR></TABLE>>];
}
FileStore [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>FileStore</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-file</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+readLines()<BR/>+writeLines(lines)</TD></TR></TABLE>>];
Main -> KitchenApp [arrowhead=vee];
Main -> OrderFacade [arrowhead=vee];
Main -> AdminFacade [arrowhead=vee];
KitchenApp -> OrderFacade [arrowhead=vee, label="creates"];
KitchenApp -> AdminFacade [arrowhead=vee, label="creates"];
OrderFacade -> OrderQueue [arrowhead=vee];
OrderFacade -> CookingLine [arrowhead=vee];
OrderFacade -> BillingModule [arrowhead=vee];
OrderFacade -> DeliveryDispatcher [arrowhead=vee];
OrderFacade -> ChainRepository [arrowhead=vee];
OrderFacade -> Compensator [arrowhead=vee];
AdminFacade -> OrderQueue [arrowhead=vee];
AdminFacade -> CookingLine [arrowhead=vee];
AdminFacade -> BillingModule [arrowhead=vee];
AdminFacade -> ChainRepository [arrowhead=vee];
AdminFacade -> Compensator [arrowhead=vee];
Compensator -> OrderQueue [arrowhead=vee];
Compensator -> CookingLine [arrowhead=vee];
Compensator -> BillingModule [arrowhead=vee];
Compensator -> ChainRepository [arrowhead=vee];
ChainRepository -> ChainRecord [arrowhead=vee];
ChainRecord -> ChainStatus [arrowhead=vee];
OrderQueue -> IntakeRepository [arrowhead=vee];
OrderQueue -> InventoryChecker [arrowhead=vee];
IntakeRepository -> Order [arrowhead=vee];
Order -> OrderStatus [arrowhead=vee];
CookingLine -> CookingRepository [arrowhead=vee];
CookingLine -> StationAllocator [arrowhead=vee];
CookingLine -> QualityChecker [arrowhead=vee];
CookingRepository -> Ticket [arrowhead=vee];
Ticket -> TicketStatus [arrowhead=vee];
BillingModule -> DeliveryRepository [arrowhead=vee];
BillingModule -> PriceCalculator [arrowhead=vee];
DeliveryDispatcher -> DeliveryRepository [arrowhead=vee];
DeliveryRepository -> Bill [arrowhead=vee];
Bill -> BillStatus [arrowhead=vee];
IntakeRepository -> FileStore [arrowhead=vee];
CookingRepository -> FileStore [arrowhead=vee];
DeliveryRepository -> FileStore [arrowhead=vee];
ChainRepository -> FileStore [arrowhead=vee];
OrderQueue -> IntakeException [style=dashed, arrowhead=vee, label="throws"];
CookingLine -> CookingException [style=dashed, arrowhead=vee, label="throws"];
BillingModule -> DeliveryException [style=dashed, arrowhead=vee, label="throws"];
OrderFacade -> OrderFailedException [style=dashed, arrowhead=vee, label="throws"];
OrderFacade -> InvalidRequestException [style=dashed, arrowhead=vee, label="throws"];
}